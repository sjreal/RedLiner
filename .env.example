# OpenCode Go; create the key in the OpenCode Console.
OPENCODE_API_KEY=
OPENCODE_MODEL=glm-5.3-flash

# Direct SMTP is the default. Select "Direct SMTP" in the dashboard too.
EMAIL_PROVIDER=smtp
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Outbound email signature identity
REDLINER_SENDER_NAME=Siddharth Jain
REDLINER_SENDER_COMPANY=BML Munjal University

# Optional: Cloudflare Worker outbound route instead of Direct SMTP.
CLOUDFLARE_WORKER_URL=http://127.0.0.1:8787
CLOUDFLARE_DISPATCH_TOKEN=

# Shared secret sent by the Worker to the inbound webhook.
REDLINER_WEBHOOK_TOKEN=

# MCP stdio tools (contract, vendor, finance). Disable only for debugging.
MCP_ENABLED=true

# Live OSINT: GLEIF is keyless; Tavily/Serper are optional richer search.
LIVE_OSINT_ENABLED=true
OSINT_TIMEOUT_SECONDS=5
OSINT_CACHE_TTL_SECONDS=86400
TAVILY_API_KEY=
SERPER_API_KEY=

# Deterministic LLM input/output guardrails (prompt injection, secrets, abuse, PII warnings)
LLM_GUARDRAILS_ENABLED=true

# Langfuse Cloud free tracing (leave blank to disable)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_TRACING_ENABLED=true
LANGFUSE_ENVIRONMENT=demo
LANGFUSE_RELEASE=redliner-demo

# A2A vendor agent (run a2a_servers/vendor_agent.py on this URL first).
A2A_ENABLED=false
A2A_VENDOR_URL=http://127.0.0.1:8001
A2A_TIMEOUT_SECONDS=20
A2A_SERVICE_TOKEN=change-this-service-token

# Optional SQLite override; defaults to data/redliner_deals.db
# REDLINER_DB_PATH=data/redliner_deals.db

# PostgreSQL/Supabase (takes precedence over SQLite when set)
# DATABASE_URL=postgresql://user:password@host:5432/postgres

# Retention purge window for events, snapshots and outbound message records
RETENTION_DAYS=90

# Human review notifications (optional)
REVIEWER_EMAIL=
REVIEWER_WEBHOOK_URL=
APPROVAL_SECRET=replace-with-a-long-random-secret
DASHBOARD_URL=http://127.0.0.1:8000

# Single shared demo login (Basic Auth). Leave blank only for local work.
DEMO_USER=demo
DEMO_PASSWORD=change-this-demo-password

# Hosted Gmail polling: no local poller needed.
GMAIL_POLL_ENABLED=false
GMAIL_POLL_FOLDER=RedLiner
GMAIL_POLL_INTERVAL=60
GMAIL_POLL_LIMIT=10
