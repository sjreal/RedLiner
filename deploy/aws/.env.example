# AWS Lightsail/EC2 public IP or DNS name
PUBLIC_HOST=203.0.113.10

# Supabase/PostgreSQL
DATABASE_URL=postgresql://user:password@host:5432/postgres

# OpenCode Go
OPENCODE_API_KEY=
OPENCODE_MODEL=glm-5.3-flash

# Direct SMTP (Gmail App Password)
EMAIL_PROVIDER=smtp
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Shared demo login
DEMO_USER=demo
DEMO_PASSWORD=change-this-demo-password

# A2A service token; must match on both containers
A2A_SERVICE_TOKEN=change-this-service-token

# Reviewer notifications
REVIEWER_EMAIL=
REVIEWER_WEBHOOK_URL=
APPROVAL_SECRET=change-this-approval-secret

# Optional
REDLINER_WEBHOOK_TOKEN=
MCP_ENABLED=true
LIVE_OSINT_ENABLED=true
LLM_GUARDRAILS_ENABLED=true
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
RETENTION_DAYS=90
